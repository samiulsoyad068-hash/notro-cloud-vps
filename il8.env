# Discord Bot Token (from Discord Developer Portal)
TOKEN=your_discord_bot_token_here

# Admin Discord User ID (get from Discord Developer Mode)
ADMIN_ID=paste your discord user id

# Bot Configuration
BOT_STATUS_NAME=VPS Manager
WATERMARK=By Notro Cloud

# VPS Defaults
DEFAULT_RAM=2g
DEFAULT_CPU=1
DEFAULT_DISK=10G
VPS_HOSTNAME=notrocloud-vps
SERVER_LIMIT=1
TOTAL_SERVER_LIMIT=60

# Database
DATABASE_FILE=bot.db

# (Optional) Register slash commands to a single guild for instant updates.
# Leave empty/null to sync globally (can take up to 1 hour to propagate).
GUILD_ID=
