# Discord Bot Token (from Discord Developer Portal)
TOKEN=TOKEN

# Admin Discord User ID(s) - comma-separated list for multiple admins, e.g. "123456789, 987654321"
# Get from Discord with Developer Mode enabled (copy user ID).
ADMIN_ID=1555551870603497567

# Bot Configuration
BOT_STATUS_NAME=VPS Manager
WATERMARK=Powered by Notro Cloud

# VPS Defaults
DEFAULT_RAM=2g
DEFAULT_CPU=1
DEFAULT_DISK=10G
VPS_HOSTNAME=notrocloud-vps
DEFAULT_DNS=1.1.1.1, 8.8.8.8
REGION=Bangladesh (BD)
SERVER_LIMIT=3
TOTAL_SERVER_LIMIT=60

# Database
DATABASE_FILE=bot.db

# (Optional) Enforce Docker resource limits (--memory, --cpus, --storage-opt).
# Off by default: VPS containers run on the host's REAL RAM/CPU/disk with NO Docker
# caps, so any RAM size (2g-24g) deploys successfully (usage bounded only by host).
# Set ENFORCE_LIMITS=1 to enforce safe per-container limits instead.
ENFORCE_LIMITS=0
# (Optional, only used when ENFORCE_LIMITS=1) Allow RAM above physical RAM via swap.
ALLOW_MEMORY_OVERCOMMIT=1

# (Optional) Register slash commands to a single guild for instant updates.
# Leave empty/null to sync globally (can take up to 1 hour to propagate).
GUILD_ID=
